// CongChain — SQLite schema (100% offline desktop/local).
// Same models as schema.prisma but provider=sqlite; generated client at
// src/generated/sqlite. Use DATABASE_PROVIDER=sqlite in .env.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Memory {
  id         String        @id @default(cuid())
  hash       String        @unique
  content    String
  model      String
  timestamp  Int
  parentHash String?
  score      Float?
  verified   Boolean       @default(false)
  zkProof    String?
  zkPublicSignals String?
  zkVerified Boolean       @default(false)
  zkMode     String?
  zkProofVersion String?
  zkHashAlgo String?
  zkGeneratedAt Int?
  poiTxHash  String?
  clientId   String?
  createdAt  DateTime      @default(now())
  children   Memory[]      @relation("MemoryTree")
  parent     Memory?       @relation("MemoryTree", fields: [parentHash], references: [hash])
  votes      InsightVote[]

  @@index([clientId])
}

// Proof of Insight — votos humanos que validam memórias AI
model InsightVote {
  id         String   @id @default(cuid())
  memoryHash String
  score      Int
  voterIp    String   @default("anonymous")
  createdAt  DateTime @default(now())
  memory     Memory   @relation(fields: [memoryHash], references: [hash])
}

// ============================================================
// Agent-to-Agent Economy — Task Marketplace
// ============================================================

model AgentTask {
  id          String   @id @default(cuid())
  title       String
  description String
  skill       String   @default("general")
  solReward   Float    @default(0.01)
  status      String   @default("open")
  posterId    String
  assigneeId  String?
  result      String?
  txHash      String?
  postedAt    DateTime @default(now())
  completedAt DateTime?
  poster      Agent    @relation("TasksPoster",   fields: [posterId],   references: [id], onDelete: Cascade)
  assignee    Agent?   @relation("TasksAssignee", fields: [assigneeId], references: [id])
}

// ============================================================
// Agent Builder — new models (EXTEND ONLY, no core changes)
// ============================================================

model Agent {
  id               String           @id @default(cuid())
  name             String
  goal             String
  personality      String           @default("friendly and helpful")
  model            String           @default("gpt")
  tools            String           @default("[]")
  template         String?
  systemPrompt     String?
  isDeployed       Boolean          @default(false)
  deployTarget     String?
  deployConfig     String?
  memoryCount      Int              @default(0)
  totalInteractions Int             @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  rules            DecisionRule[]
  decisions        DecisionRecord[]
  tasksPosted      AgentTask[]      @relation("TasksPoster")
  tasksAssigned    AgentTask[]      @relation("TasksAssignee")
  solanaIntents    SolanaIntent[]
}

// ============================================================
// API Keys — external agent authentication + billing foundation
// ============================================================

model ApiKey {
  id             String    @id @default(cuid())
  keyHash        String    @unique
  keyPrefix      String
  name           String
  owner          String
  plan           String    @default("free")
  isActive       Boolean   @default(true)
  requestsToday  Int       @default(0)
  requestsTotal  Int       @default(0)
  memoriesSaved  Int       @default(0)
  tokensUsed     Int       @default(0)
  lastUsedAt     DateTime?
  rateResetAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([keyHash])
}

// ============================================================
// Response Cache — zero-API-cost answers for repeated questions
// ============================================================

model ResponseCache {
  id           String    @id @default(cuid())
  questionHash String    @unique
  fuzzyHash    String?
  question     String
  answer       String
  model        String
  hits         Int       @default(0)
  tokensSaved  Int       @default(0)
  seeded       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@index([fuzzyHash])
}

// ============================================================
// Wallet Agent Alert History - durable metadata receipts
// ============================================================

model WalletAgentAlertReceipt {
  id                    String   @id @default(cuid())
  ownerEmail            String
  recordId              String
  deliveryId            String
  ruleId                String
  draftId               String
  receiptId             String
  receiptStatus         String
  target                String
  provider              String
  title                 String
  message               String
  eventAt               DateTime
  storageMode           String   @default("database")
  storageReason         String
  safetyNotes           Json
  metadataOnly          Boolean  @default(true)
  canStoreSecrets       Boolean  @default(false)
  canExecuteTransaction Boolean  @default(false)
  canSchedule           Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([ownerEmail, receiptId])
  @@index([ownerEmail, eventAt])
  @@index([ownerEmail, receiptStatus])
  @@index([deliveryId])
  @@index([ruleId])
}

model SolanaIntent {
  id          String    @id @default(cuid())
  agentId     String
  type        String
  description String
  fromToken   String
  toToken     String?
  amount      Float
  amountUsd   Float?
  simulation  String?
  status      String    @default("pending")
  txHash      String?
  error       String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  executedAt  DateTime?
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
}

model DecisionRule {
  id            String   @id @default(cuid())
  agentId       String
  name          String
  condition     String   @default("{}")
  action        String   @default("notify")
  params        String   @default("{}")
  isActive      Boolean  @default(true)
  lastTriggered Int?
  triggerCount  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  decisions     DecisionRecord[]
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model DecisionRecord {
  id        String   @id @default(cuid())
  agentId   String
  ruleId    String
  condition String
  action    String
  result    String   @default("pending")
  evidence  String?
  output    String?
  txHash    String?
  timestamp Int
  createdAt DateTime @default(now())
  rule      DecisionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  agent     Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
}
