{
  "name": "congchain-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CongChain desktop app (Electron) - Forge + Mythos rodando localmente, igual ao Cursor.",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "xyz.congchain.desktop",
    "productName": "CongChain",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.next",
        "to": "app/.next"
      },
      {
        "from": "../public",
        "to": "app/public"
      },
      {
        "from": "../server.js",
        "to": "app/server.js"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "CongChain-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
